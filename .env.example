# =============================================================================
# DOMINIO DEL MAR (COEV - PNA) — CONFIGURACIÓN DE ENTORNO (.env)
# =============================================================================
# Si estas variables de Supabase no están definidas, el servidor utiliza
# automáticamente la Base de Datos Transaccional Local (data/db.json) con el
# mismo esquema, tokens firmados HMAC-SHA256 y control de permisos RBAC.
# Para conectar con Supabase en producción, copiá este archivo como `.env`
# y completá las siguientes 3 credenciales de tu proyecto Supabase:

PORT=3080
AUTH_SECRET=ddm_pna_2026_hmac_secret_key_change_in_production

# Credenciales del Administrador Autorizado
ADMIN_MASTER_TOKEN=ADMIN-PNA-2026
ADMIN_PIN=2026
ADMIN_EMAIL=admin@dominiodelmar.edu.ar

# Credenciales externas de Supabase (Opcionales en desarrollo local / Requeridas para nube Supabase)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
